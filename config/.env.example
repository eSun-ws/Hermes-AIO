# =============================================================================
# Hermes All-in-One v2 — environment template (copy to config/.env)
# -----------------------------------------------------------------------------
# WARNING: this file lives in config/. Compose only auto-reads a project-root .env
# for ${VAR} interpolation, so every docker compose command needs
# `--env-file config/.env` (init.sh does this for you).
# Format: one KEY=VALUE per line; a '#' at the start of a line is a comment;
# inline (trailing) comments are NOT supported.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────
# 1. Data volumes (host paths)
# ──────────────────────────────────────────────────────────────────────────
# Source directory: both hermes and webui sources live here (`hermes update` writes to it)
HOST_SRC_DIR=./src
# HERMES_HOME: dependency environments (tools/installs), config, sessions, logs
HOST_HERMES_HOME=./hermes-data
# Default agent workspace
HOST_WORKSPACE=./workspace

# ──────────────────────────────────────────────────────────────────────────
# 2. Source channel and update cadence
# ──────────────────────────────────────────────────────────────────────────
# Which channel the official install.sh uses on first boot: stable (latest release, default) or main
HERMES_CHANNEL=stable

# Scheduled update interval in hours (0 = disabled). The bare-metal flow is:
# update the agent -> restart the WebUI -> then update the WebUI itself (after an
# agent update the WebUI process still holds the old modules, which shows up as
# "opens but cannot chat").
UPDATE_AGENT_TIME=48
UPDATE_WEBUI_TIME=48

# Skip the browser / computer-use components during the first install (saves time;
# add them later with `hermes pm install <name>`)
HERMES_SKIP_BROWSER=0
HERMES_SKIP_COMPUTER_USE=0

# ──────────────────────────────────────────────────────────────────────────
# 3. Ports
# ──────────────────────────────────────────────────────────────────────────
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_BOT_NAME=Hermes
# Master password: shared by WebUI and Dashboard. Empty = generated on first boot
# and printed to docker logs
HERMES_WEBUI_PASSWORD=

# Dashboard (0 = disabled)
HERMES_DASHBOARD_ON=0
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
# WARNING: use our own variable name. Once HERMES_DASHBOARD_BASIC_AUTH_USERNAME is
# injected into the container environment, the agent sees "a username but no
# password" and refuses to start (the WebUI simply will not open).
DASH_BASIC_AUTH_USER=hermes

# Whether the WebUI update button also checks/updates the agent (written into the
# WebUI settings.json)
#   1 = do not check (default, recommended): the WebUI only manages itself; the agent
#       is driven by hermes update (stable, on the 48h schedule)
#   0 = let the WebUI check the agent too -- note that upstream pulls origin/main,
#       bypassing the agent's own stable channel; measured, this moves the agent from
#       v0.22.2 onto the development line (rc.5-v0.22.3-1-g...), out of step with the
#       WebUI's release line
WEBUI_IGNORE_AGENT_UPDATES=1

# Gateway / OpenAI-compatible API (8642 must be available)
# WARNING: the API key must be >=16 characters. When the master password is shorter,
# the entrypoint generates a separate key and prints it.
HERMES_API_GW=1
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# API_SERVER_KEY=

# Port range for ad-hoc agent demo/test services
OPEN_PORT=3111-3113

# ──────────────────────────────────────────────────────────────────────────
# 4. hindsight plugin (dependencies installed, provider NOT activated)
# ──────────────────────────────────────────────────────────────────────────
HINDSIGHT_PLUGIN=on

# Whether to install the plugin dependencies on first boot
# (hindsight-client / hindsight-embed, ~400 MB)
#   1 = install them (default): the Dashboard will only ask for the service URL and
#       credentials
#   0 = do not install: the Dashboard shows "Install provider dependencies" on the
#       first enable, and you click it
# WARNING: these dependencies are not installed by `plugins install` but by the
# isolated environment that `plugins enable` creates. This script triggers that for
# you (it only enables the plugin and never writes memory.provider; choosing the
# provider is still up to you in the UI).
HINDSIGHT_PREPARE=1

# ──────────────────────────────────────────────────────────────────────────
# 5. Model providers (the image ships no presets; configure them in the WebUI or
#    Dashboard after first boot)
# ──────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XIAOMI_API_KEY=
