# =============================================================================
# Hermes All-in-One v2 — 环境变量模板（cp 成 config/.env）
# -----------------------------------------------------------------------------
# ⚠ 本文件位于 config/：compose 的 ${VAR} 插值只自动读项目根 .env，所以所有
#   docker compose 命令都要加 `--env-file config/.env`（init.sh 已自动处理）。
# 格式：KEY=VALUE 每行一个；'#' 整行为注释；不支持行尾注释。
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────
# 一、数据卷（宿主路径）
# ──────────────────────────────────────────────────────────────────────────
# 源码目录：hermes 与 webui 的源码都装在这里（`hermes update` 直接改它）
HOST_SRC_DIR=./src
# HERMES_HOME：依赖环境(tools/installs)/config/会话/日志
HOST_HERMES_HOME=./hermes-data
# Agent 默认工作区
HOST_WORKSPACE=./workspace

# ──────────────────────────────────────────────────────────────────────────
# 二、源码通道与更新节奏
# ──────────────────────────────────────────────────────────────────────────
# 首启安装时用官方 install.sh 的哪个通道：stable（最新 release，默认）或 main
HERMES_CHANNEL=stable

# 定时更新间隔（小时，0 = 关闭）。真机流程：agent 更新完 → 重启 WebUI →
# 再更新 WebUI（更新后 WebUI 进程里仍是旧模块，表现为“能打开但不能对话”）。
UPDATE_AGENT_TIME=48
UPDATE_WEBUI_TIME=48

# 首启安装时跳过浏览器/computer-use 组件（省时间；之后可 hermes pm install <name> 补回）
HERMES_SKIP_BROWSER=0
HERMES_SKIP_COMPUTER_USE=0

# ──────────────────────────────────────────────────────────────────────────
# 三、访问端口
# ──────────────────────────────────────────────────────────────────────────
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_BOT_NAME=Hermes
# 主密码：WebUI / Dashboard 共用。留空＝首启随机生成并打印到 docker logs
HERMES_WEBUI_PASSWORD=

# Dashboard（0=关闭）
HERMES_DASHBOARD_ON=0
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
# ⚠ 用我们自己的变量名：HERMES_DASHBOARD_BASIC_AUTH_USERNAME 一旦注入容器环境，
#   agent 会看到“有 username 无 password”并拒绝启动（WebUI 直接打不开）。
DASH_BASIC_AUTH_USER=hermes

# WebUI 的更新按钮是否也去检查/更新 agent（写进 WebUI 的 settings.json）
#   1 = 不检查（默认，推荐）：WebUI 只管自己；agent 由 hermes update（stable，48h 定时）驱动
#   0 = 允许 WebUI 检查 agent —— 注意上游会按 origin/main 拉，绕过 agent 自己的 stable 通道，
#       实测会把 agent 从 v0.22.2 带到开发线（rc.5-v0.22.3-1-g…），与 WebUI 的版本线错位
WEBUI_IGNORE_AGENT_UPDATES=1

# 网关 / OpenAI 兼容 API（8642 必须可用）
# ⚠ API key 要求 ≥16 位：主密码不足 16 位时 entrypoint 会自动生成独立 key 并打印
HERMES_API_GW=1
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# API_SERVER_KEY=

# Agent 临时 demo/测试服务端口段
OPEN_PORT=3111-3113

# ──────────────────────────────────────────────────────────────────────────
# 四、hindsight 插件（装好依赖，但不激活 provider）
# ──────────────────────────────────────────────────────────────────────────
HINDSIGHT_PLUGIN=on

# 是否在首启就安装插件依赖（hindsight-client / hindsight-embed，约 400 MB）
#   1 = 装好（默认）：Dashboard 里只会让您填服务地址/凭证
#   0 = 不装：首次启用时 Dashboard 会显示 “Install provider dependencies” 让您点
# ⚠ 这些依赖不是 `plugins install` 装的，而是 `plugins enable` 阶段建的隔离环境；
#   本脚本会替您触发（只启用插件，不写 memory.provider，provider 仍由您在界面选）。
HINDSIGHT_PREPARE=1

# ──────────────────────────────────────────────────────────────────────────
# 五、模型 Provider（本镜像零预设，首启后在 WebUI/Dashboard 里配）
# ──────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XIAOMI_API_KEY=
